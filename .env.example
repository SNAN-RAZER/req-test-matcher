# All inference stays on this machine. Do not set cloud API keys.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b

# Force offline Hugging Face / Docling model downloads after first local cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DOCLING_ARTIFACTS_PATH=

# Disable telemetry from libraries
ANONYMIZED_TELEMETRY=false
CHROMA_TELEMETRY=false
LANGCHAIN_TRACING_V2=false
POSTHOG_DISABLED=1

APP_HOST=127.0.0.1
APP_PORT=8080
